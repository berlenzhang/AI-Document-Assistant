# No API key required by default — the app runs fully locally with flan-t5.
# Optional overrides:
# HF_MODEL=google/flan-t5-base

# LLM generation backend: "flan_t5" (default, fully local) or "claude" (Anthropic API).
# LLM_PROVIDER=flan_t5

# Required when LLM_PROVIDER=claude, and to run eval/faithfulness_eval.py
# (LLM-as-judge check + the Claude generation provider it compares against).
# ANTHROPIC_API_KEY=
# EVAL_JUDGE_MODEL=claude-opus-4-8
# LLM_CLAUDE_MODEL=claude-opus-4-8
# LLM_CLAUDE_MAX_TOKENS=1024
# LLM_CLAUDE_THINKING_ENABLED=false
